package web

import (
	"cmp"
	"strconv"
	"time"

	"github.com/keelkit/keelkit/reference/static"
)

// Layout — оболочка публичной страницы без адреса для поисковиков (ошибки, заглушки). title пуст — в <title>
// только название сайта. Страница с адресом — LayoutMeta.
templ Layout(title string) {
	@LayoutMeta(Meta{Title: title}) {
		{ children... }
	}
}

// LayoutMeta — оболочка любой публичной страницы с данными для поисковиков и соцсетей: описание (пустое —
// описание сайта), canonical и Open Graph (если задан m.Path), og:image (нет своей — картинка из настроек),
// ссылка на RSS-ленту, коды подтверждения сайта; в подвале — контакты, внизу — баннер cookies.
// Язык страницы — из site.yaml (languages: [ru]).
templ LayoutMeta(m Meta) {
	{{ site := SiteFrom(ctx) }}
	{{ m = Defaults(m, site) }}
	<!DOCTYPE html>
	<html lang="ru">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ TitleTag(m, site.Name) }</title>
			if m.Description != "" {
				<meta name="description" content={ m.Description }/>
			}
			if m.NoIndex {
				<meta name="robots" content="noindex"/>
			}
			if site.Verification.Yandex != "" {
				<meta name="yandex-verification" content={ site.Verification.Yandex }/>
			}
			if site.Verification.Google != "" {
				<meta name="google-site-verification" content={ site.Verification.Google }/>
			}
			if m.Path != "" {
				@openGraph(site, m)
			}
			if site.Feed != "" {
				<link rel="alternate" type="application/rss+xml" title={ site.Name } href={ site.Feed }/>
			}
			<link rel="icon" type="image/svg+xml" href={ static.Path("favicon.svg") }/>
			<link rel="stylesheet" href={ static.Path("style.css") }/>
			<script src={ static.Path("htmx-2.0.11.min.js") } defer></script>
		</head>
		<body>
			@header(site)
			<main class="container">
				{ children... }
			</main>
			@footer(site)
			if site.Cookie.Show() {
				@cookieBanner(site)
			}
		</body>
	</html>
}

// openGraph — canonical и Open Graph страницы с адресом: абсолютные адреса от site.BaseURL.
// og:title — заголовок без названия сайта (оно в og:site_name); у главной — название сайта.
templ openGraph(site Site, m Meta) {
	<link rel="canonical" href={ site.BaseURL + m.Path }/>
	<meta property="og:site_name" content={ site.Name }/>
	<meta property="og:locale" content="ru_RU"/>
	<meta property="og:title" content={ cmp.Or(m.Title, site.Name) }/>
	if m.Description != "" {
		<meta property="og:description" content={ m.Description }/>
	}
	<meta property="og:url" content={ site.BaseURL + m.Path }/>
	if m.Article {
		<meta property="og:type" content="article"/>
		if m.Published != "" {
			<meta property="article:published_time" content={ m.Published }/>
		}
	} else {
		<meta property="og:type" content="website"/>
	}
	if v, ok := ShareImage(m.Image); ok {
		<meta property="og:image" content={ site.BaseURL + MediaURL(v) }/>
		<meta property="og:image:type" content="image/jpeg"/>
		<meta property="og:image:width" content={ strconv.Itoa(v.Width) }/>
		<meta property="og:image:height" content={ strconv.Itoa(v.Height) }/>
		if m.ImageAlt != "" {
			<meta property="og:image:alt" content={ m.ImageAlt }/>
		}
		<meta name="twitter:card" content="summary_large_image"/>
	} else {
		<meta name="twitter:card" content="summary"/>
	}
}

// Имена меню из site.yaml (menus), которые выводит layout: основное — в шапке, второе — в подвале.
const (
	mainMenu   = "main"
	footerMenu = "footer"
)

templ header(site Site) {
	<header class="site-header">
		<div class="container">
			<a class="site-name" href="/">{ site.Name }</a>
			if links := site.Menus[mainMenu]; len(links) > 0 {
				<nav class="site-nav" aria-label="Основное меню">
					@menuList(links, false)
				</nav>
			}
		</div>
	</header>
}

// menuList — пункты меню списком; подпункты — вложенным списком с классом sub (в шапке — выпадающий по наведению
// и фокусу, в подвале — колонкой под пунктом).
templ menuList(links []Link, sub bool) {
	<ul
		if sub {
			class="sub"
		}
	>
		for _, l := range links {
			<li
				if len(l.Children) > 0 {
					class="has-children"
				}
			>
				@menuLink(l)
				if len(l.Children) > 0 {
					@menuList(l.Children, true)
				}
			</li>
		}
	</ul>
}

// menuLink — ссылка пункта: текущая страница — aria-current, раздел с текущей страницей внутри — класс active.
templ menuLink(l Link) {
	<a
		href={ templ.URL(l.URL) }
		if l.Current {
			aria-current="page"
		} else if l.Active {
			class="active"
		}
	>{ l.Title }</a>
}

templ footer(site Site) {
	{{ c := site.Contacts }}
	<footer class="site-footer">
		<div class="container">
			if links := site.Menus[footerMenu]; len(links) > 0 {
				<nav class="footer-nav" aria-label="Меню в подвале">
					@menuList(links, false)
				</nav>
			}
			if c != (Contacts{}) {
				<address class="contacts">
					if c.Address != "" {
						<p class="contacts-address">{ c.Address }</p>
					}
					if c.Phone != "" {
						<p>
							if tel := TelURL(c.Phone); tel != "" {
								<a href={ templ.SafeURL(tel) }>{ c.Phone }</a>
							} else {
								{ c.Phone }
							}
						</p>
					}
					if c.Email != "" {
						<p><a href={ templ.SafeURL("mailto:" + c.Email) }>{ c.Email }</a></p>
					}
				</address>
			}
			if len(site.Social) > 0 {
				<ul class="social-links" aria-label="Мы в соцсетях">
					for _, l := range site.Social {
						<li><a href={ templ.URL(l.URL) } rel="me noopener">{ l.Title }</a></li>
					}
				</ul>
			}
			<p>© { strconv.Itoa(time.Now().Year()) } { site.Name }</p>
		</div>
	</footer>
}

// cookieBanner — уведомление о cookie. «Понятно» — обычная форма (без JavaScript — 303 обратно на страницу),
// с htmx баннер заменяется пустым ответом.
templ cookieBanner(site Site) {
	<div class="cookie-banner" role="region" aria-label="Уведомление о cookie">
		<div class="container">
			<p>
				{ site.Cookie.Text }
				if site.Cookie.Link != "" {
					{ " " }
					<a href={ templ.SafeURL(site.Cookie.Link) }>Подробнее</a>
				}
			</p>
			<form
				method="post"
				action={ templ.SafeURL(CookieNoticePath) }
				hx-post={ CookieNoticePath }
				hx-target="closest .cookie-banner"
				hx-swap="outerHTML"
			>
				<input type="hidden" name="back" value={ site.Path }/>
				<button type="submit">Понятно</button>
			</form>
		</div>
	</div>
}

// NotFoundPage — страница 404.
templ NotFoundPage() {
	@Layout("Страница не найдена") {
		<section class="error-page">
			<p class="error-code">404</p>
			<h1>Страница не найдена</h1>
			<p>Возможно, её удалили или в адресе опечатка.</p>
			<p><a href="/">На главную</a></p>
		</section>
	}
}

// ErrorPage — страница 500; подробности ошибки только в логе.
templ ErrorPage() {
	@Layout("Ошибка сервера") {
		<section class="error-page">
			<p class="error-code">500</p>
			<h1>Что-то пошло не так</h1>
			<p>Попробуйте обновить страницу чуть позже.</p>
			<p><a href="/">На главную</a></p>
		</section>
	}
}

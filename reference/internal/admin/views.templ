package admin

import (
	"encoding/json"
	"strconv"
	"strings"

	"github.com/voffkin/keelkit/reference/internal/web"
	"github.com/voffkin/keelkit/reference/static"
)

// Layout — оболочка страниц админки, в том числе разделов типов контента. Вошедшему пользователю — меню
// (дашборд, разделы из Options.Sections, сайт) и кнопка «Выйти»; CSRF-токен сессии передаётся в htmx-запросы
// заголовком через hx-headers. htmx-config разрешает подменять разметку ответом 422: так приходят ошибки валидации форм.
templ Layout(title string) {
	{{ site := web.SiteFrom(ctx) }}
	{{ s, signedIn := sessionFrom(ctx) }}
	{{ path := requestPath(ctx) }}
	<!DOCTYPE html>
	<html lang="ru">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="robots" content="noindex, nofollow"/>
			<title>{ title } — Админка — { site.Name }</title>
			<link rel="icon" type="image/svg+xml" href={ static.Path("favicon.svg") }/>
			<link rel="stylesheet" href={ static.Path("style.css") }/>
			<meta name="htmx-config" content={ htmxConfig }/>
			<script src={ static.Path("htmx-2.0.11.min.js") } defer></script>
		</head>
		<body
			class="admin"
			if signedIn {
				hx-headers={ csrfHeaders(s.csrf) }
			}
		>
			<header class="site-header admin-header">
				<div class="container">
					<a class="site-name" href={ templ.SafeURL(dashboardPath) }>{ site.Name } · Админка</a>
					if signedIn {
						<nav class="site-nav" aria-label="Меню админки">
							<ul>
								@navLink(dashboardPath, "Дашборд", path == dashboardPath)
								for _, sec := range s.sections {
									@navLink(sec.URL, sec.Title, path == sec.URL || strings.HasPrefix(path, sec.URL+"/"))
								}
								<li><a href="/">На сайт</a></li>
								<li>
									<form class="logout" method="post" action={ templ.SafeURL(logoutPath) }>
										<input type="hidden" name={ csrfField } value={ s.csrf }/>
										<span class="admin-user">{ s.user.Email }</span>
										<button type="submit" class="link-button">Выйти</button>
									</form>
								</li>
							</ul>
						</nav>
					}
				</div>
			</header>
			<main class="container">
				{ children... }
			</main>
		</body>
	</html>
}

// LoginPage — форма входа.
templ LoginPage(f loginForm) {
	@Layout("Вход") {
		<section class="login">
			<h1>Вход</h1>
			if f.Error != "" {
				<p class="form-error" role="alert">{ f.Error }</p>
			}
			<form method="post" action={ templ.SafeURL(loginPath) } class="form">
				<input type="hidden" name={ csrfField } value={ f.CSRF }/>
				<input type="hidden" name="next" value={ f.Next }/>
				<label>
					Email
					<input type="email" name="email" value={ f.Email } autocomplete="username" required autofocus?={ f.Email == "" }/>
				</label>
				<label>
					Пароль
					<input type="password" name="password" autocomplete="current-password" required autofocus?={ f.Email != "" }/>
				</label>
				<button type="submit">Войти</button>
			</form>
		</section>
	}
}

// DashboardPage — дашборд: счётчики контента.
templ DashboardPage(counters []Counter) {
	@Layout("Дашборд") {
		<h1>Дашборд</h1>
		if len(counters) > 0 {
			<ul class="counters">
				for _, c := range counters {
					<li class="counter">
						if c.URL != "" {
							<a href={ templ.SafeURL(c.URL) }>{ c.Label }</a>: <strong>{ strconv.FormatInt(c.Value, 10) }</strong>
						} else {
							{ c.Label }: <strong>{ strconv.FormatInt(c.Value, 10) }</strong>
						}
					</li>
				}
			</ul>
		}
	}
}

// ForbiddenPage — 403: запрос без верного CSRF-токена.
templ ForbiddenPage() {
	@Layout("Доступ запрещён") {
		<section class="error-page">
			<p class="error-code">403</p>
			<h1>Доступ запрещён</h1>
			<p>Форма устарела или отправлена с другого сайта. Обновите страницу и попробуйте ещё раз.</p>
			<p><a href={ templ.SafeURL(dashboardPath) }>На дашборд</a></p>
		</section>
	}
}

// NotFoundPage — 404 внутри админки: неизвестный путь или запись, которой нет.
templ NotFoundPage() {
	@Layout("Не найдено") {
		<section class="error-page">
			<p class="error-code">404</p>
			<h1>Не найдено</h1>
			<p>Такого раздела или записи нет: возможно, её удалили.</p>
			<p><a href={ templ.SafeURL(dashboardPath) }>На дашборд</a></p>
		</section>
	}
}

// ErrorPage — 500; подробности ошибки только в логе.
templ ErrorPage() {
	@Layout("Ошибка сервера") {
		<section class="error-page">
			<p class="error-code">500</p>
			<h1>Что-то пошло не так</h1>
			<p>Попробуйте обновить страницу чуть позже.</p>
		</section>
	}
}

templ navLink(url, title string, current bool) {
	<li>
		if current {
			<a href={ templ.SafeURL(url) } aria-current="page">{ title }</a>
		} else {
			<a href={ templ.SafeURL(url) }>{ title }</a>
		}
	</li>
}

// CSRFInput — скрытое поле с CSRF-токеном сессии для форм админки (только внутри RequireUser).
templ CSRFInput() {
	<input type="hidden" name={ csrfField } value={ CSRFToken(ctx) }/>
}

// htmxConfig — настройки htmx админки: ответ 422 (ошибки валидации) подменяет разметку, как 2xx;
// остальные коды — по умолчанию htmx (204 не трогает страницу, 4xx/5xx — ошибка без подмены).
const htmxConfig = `{"responseHandling":[{"code":"204","swap":false},{"code":"[23]..","swap":true},{"code":"422","swap":true},{"code":"[45]..","swap":false,"error":true}]}`

// csrfHeaders — значение hx-headers: JSON с CSRF-токеном.
func csrfHeaders(token string) string {
	b, _ := json.Marshal(map[string]string{csrfHeader: token})
	return string(b)
}

package admin

import (
	"encoding/json"
	"strconv"
	"strings"

	"github.com/voffkin/keelkit/modules/auth"

	"github.com/voffkin/keelkit/reference/internal/web"
	"github.com/voffkin/keelkit/reference/static"
)

// Layout — оболочка страниц админки, в том числе разделов типов контента. Вошедшему пользователю — верхняя панель
// (ссылка на сайт, пользователь, «Выйти») и боковое меню (дашборд, разделы из Options.Sections); на узком экране
// меню становится строкой под панелью. CSRF-токен сессии передаётся в htmx-запросы заголовком через hx-headers.
// htmx-config разрешает подменять разметку ответом 422: так приходят ошибки валидации форм.
templ Layout(title string) {
	{{ site := web.SiteFrom(ctx) }}
	{{ user, signedIn := auth.UserFrom(ctx) }}
	{{ csrf := auth.CSRFToken(ctx) }}
	{{ s := shellFrom(ctx) }}
	{{ path := s.path }}
	<!DOCTYPE html>
	<html lang="ru">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="robots" content="noindex, nofollow"/>
			<title>{ title } — Админка — { site.Name }</title>
			<link rel="icon" type="image/svg+xml" href={ static.Path("favicon.svg") }/>
			<link rel="stylesheet" href={ static.Path("style.css") }/>
			<link rel="stylesheet" href={ static.Path("admin.css") }/>
			<meta name="htmx-config" content={ htmxConfig }/>
			<script src={ static.Path("htmx-2.0.11.min.js") } defer></script>
			<script src={ static.Path("editor.js") } defer></script>
		</head>
		<body
			class="admin"
			if signedIn {
				hx-headers={ csrfHeaders(csrf) }
			}
		>
			<header class="site-header admin-header">
				<a class="site-name admin-brand" href={ templ.SafeURL(dashboardPath) }>
					<span class="admin-logo" aria-hidden="true">{ initial(site.Name) }</span>
					<span class="admin-brand-text">
						<span class="admin-brand-name">{ site.Name }</span>
						<span class="admin-brand-sub">Админка</span>
					</span>
				</a>
				if signedIn {
					<div class="admin-topbar">
						<a class="admin-chip" href="/">
							@icon("external")
							<span>На сайт</span>
						</a>
						<form class="logout" method="post" action={ templ.SafeURL(logoutPath) }>
							<input type="hidden" name={ auth.CSRFField } value={ csrf }/>
							<span class="admin-avatar" aria-hidden="true">{ initial(user.Email) }</span>
							<span class="admin-user">{ user.Email }</span>
							<button type="submit" class="admin-chip">
								@icon("logout")
								<span>Выйти</span>
							</button>
						</form>
					</div>
				}
			</header>
			if signedIn {
				<div class="admin-shell">
					<nav class="site-nav admin-sidebar" aria-label="Меню админки">
						<p class="admin-nav-label">Главное</p>
						<ul>
							@navLink(dashboardPath, "Дашборд", "dashboard", path == dashboardPath)
						</ul>
						if len(s.sections) > 0 {
							<p class="admin-nav-label">Контент</p>
							<ul>
								for _, sec := range s.sections {
									@navLink(sec.URL, sec.Title, sec.Icon, path == sec.URL || strings.HasPrefix(path, sec.URL+"/"))
								}
							</ul>
						}
						if len(s.site) > 0 {
							<p class="admin-nav-label">Сайт</p>
							<ul>
								for _, sec := range s.site {
									@navLink(sec.URL, sec.Title, sec.Icon, path == sec.URL || strings.HasPrefix(path, sec.URL+"/"))
								}
							</ul>
						}
					</nav>
					<main class="admin-main">
						{ children... }
					</main>
				</div>
			} else {
				<main class="admin-main admin-guest">
					{ children... }
				</main>
			}
		</body>
	</html>
}

// LoginPage — форма входа.
templ LoginPage(f loginForm) {
	@Layout("Вход") {
		<section class="login">
			<h1>Вход</h1>
			if f.Error != "" {
				<p class="form-error" role="alert">{ f.Error }</p>
			}
			<form method="post" action={ templ.SafeURL(loginPath) } class="form">
				<input type="hidden" name={ auth.CSRFField } value={ f.CSRF }/>
				<input type="hidden" name="next" value={ f.Next }/>
				<label>
					Email
					<input type="email" name="email" value={ f.Email } autocomplete="username" required autofocus?={ f.Email == "" }/>
				</label>
				<label>
					Пароль
					<input type="password" name="password" autocomplete="current-password" required autofocus?={ f.Email != "" }/>
				</label>
				<button type="submit">Войти</button>
			</form>
		</section>
	}
}

// DashboardPage — дашборд: счётчики контента.
templ DashboardPage(counters []Counter) {
	@Layout("Дашборд") {
		<h1>Дашборд</h1>
		if len(counters) > 0 {
			<ul class="counters">
				for _, c := range counters {
					<li class="counter">
						if c.URL != "" {
							<a href={ templ.SafeURL(c.URL) }>{ c.Label }</a>: <strong>{ strconv.FormatInt(c.Value, 10) }</strong>
						} else {
							{ c.Label }: <strong>{ strconv.FormatInt(c.Value, 10) }</strong>
						}
					</li>
				}
			</ul>
		}
	}
}

// ForbiddenPage — 403: запрос без верного CSRF-токена.
templ ForbiddenPage() {
	@Layout("Доступ запрещён") {
		<section class="error-page">
			<p class="error-code">403</p>
			<h1>Доступ запрещён</h1>
			<p>Форма устарела или отправлена с другого сайта. Обновите страницу и попробуйте ещё раз.</p>
			<p><a href={ templ.SafeURL(dashboardPath) }>На дашборд</a></p>
		</section>
	}
}

// NotFoundPage — 404 внутри админки: неизвестный путь или запись, которой нет.
templ NotFoundPage() {
	@Layout("Не найдено") {
		<section class="error-page">
			<p class="error-code">404</p>
			<h1>Не найдено</h1>
			<p>Такого раздела или записи нет: возможно, её удалили.</p>
			<p><a href={ templ.SafeURL(dashboardPath) }>На дашборд</a></p>
		</section>
	}
}

// ErrorPage — 500; подробности ошибки только в логе.
templ ErrorPage() {
	@Layout("Ошибка сервера") {
		<section class="error-page">
			<p class="error-code">500</p>
			<h1>Что-то пошло не так</h1>
			<p>Попробуйте обновить страницу чуть позже.</p>
		</section>
	}
}

templ navLink(url, title, iconName string, current bool) {
	<li>
		<a
			href={ templ.SafeURL(url) }
			if current {
				aria-current="page"
			}
		>
			@icon(iconName)
			<span>{ title }</span>
		</a>
	</li>
}

// icon — иконка меню и кнопок панели: контурная, 24×24, цвет — currentColor. Неизвестное имя — папка.
templ icon(name string) {
	<svg class="icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		switch name {
			case "dashboard":
				<rect x="3" y="3" width="7" height="9" rx="1.5"></rect>
				<rect x="14" y="3" width="7" height="5" rx="1.5"></rect>
				<rect x="14" y="12" width="7" height="9" rx="1.5"></rect>
				<rect x="3" y="16" width="7" height="5" rx="1.5"></rect>
			case "pages":
				<path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"></path>
				<path d="M14 3v5h5M9 13h6M9 17h6"></path>
			case "posts":
				<path d="M12 20h9"></path>
				<path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"></path>
			case "tags":
				<path d="M20.6 13.4 13.4 20.6a2 2 0 0 1-2.8 0L3 13V3h10l7.6 7.6a2 2 0 0 1 0 2.8z"></path>
				<circle cx="7.5" cy="7.5" r="1.5"></circle>
			case "image":
				<rect x="3" y="3" width="18" height="18" rx="2"></rect>
				<circle cx="9" cy="9" r="2"></circle>
				<path d="m21 15-3.1-3.1a2 2 0 0 0-2.8 0L6 21"></path>
			case "settings":
				<circle cx="12" cy="12" r="3"></circle>
				<path d="M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z"></path>
			case "menu":
				<path d="M4 6h16M4 12h16M4 18h10"></path>
			case "external":
				<path d="M15 3h6v6M10 14 21 3"></path>
				<path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
			case "logout":
				<path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9"></path>
			default:
				<path d="M4 20h16a1 1 0 0 0 1-1V8a1 1 0 0 0-1-1h-8l-2-3H4a1 1 0 0 0-1 1v14a1 1 0 0 0 1 1z"></path>
		}
	</svg>
}

// CSRFInput — скрытое поле с CSRF-токеном сессии для форм админки (только внутри RequireUser).
templ CSRFInput() {
	<input type="hidden" name={ auth.CSRFField } value={ auth.CSRFToken(ctx) }/>
}

// htmxConfig — настройки htmx админки: ответ 422 (ошибки валидации) подменяет разметку, как 2xx;
// остальные коды — по умолчанию htmx (204 не трогает страницу, 4xx/5xx — ошибка без подмены).
const htmxConfig = `{"responseHandling":[{"code":"204","swap":false},{"code":"[23]..","swap":true},{"code":"422","swap":true},{"code":"[45]..","swap":false,"error":true}]}`

// initial — первая буква строки заглавной: знак сайта в панели и аватар пользователя.
func initial(s string) string {
	for _, r := range s {
		return strings.ToUpper(string(r))
	}
	return ""
}

// csrfHeaders — значение hx-headers: JSON с CSRF-токеном.
func csrfHeaders(token string) string {
	b, _ := json.Marshal(map[string]string{auth.CSRFHeader: token})
	return string(b)
}

package blocks

import (
	"context"
	"io"
	"log/slog"
	"strings"

	"github.com/voffkin/keelkit/modules/files"
	"github.com/voffkin/keelkit/modules/images"
	"github.com/voffkin/keelkit/modules/richtext"

	"github.com/voffkin/keelkit/reference/internal/web"
)

// Ширина картинок в вёрстке (атрибут sizes): блок — во всю колонку текста (--measure в style.css),
// в image_text — половина колонки на широком экране.
const (
	sizesFull = "(min-width: 46rem) 44rem, calc(100vw - 2rem)"
	sizesHalf = "(min-width: 46rem) 21rem, calc(100vw - 2rem)"
	// sizesSlide — слайд галереи: 85% колонки, чтобы был виден край следующего (.gallery-track в style.css).
	sizesSlide = "(min-width: 46rem) 37.5rem, 85vw"
)

// View — блоки на сайте по порядку; скрытые и неизвестные не выводятся. Якорь блока — id="block-<ID>".
// fs — файлы блоков file (ResolveFiles); lists — записи блоков-списков (ListSources.Resolve); nil — у типа
// контента таких блоков нет.
templ View(list []Block, res Resolved, fs Files, lists Lists) {
	for _, b := range list {
		if !b.Hidden {
			@b.Content.view(b, viewEnv{res: res, files: fs, lists: lists})
		}
	}
}

templ textView(b Block, t *Text) {
	<div class="block block-text" id={ "block-" + b.ID }>
		@markdown(t.Body)
	</div>
}

templ imageView(b Block, m *Image, img, mobile *images.Image) {
	if img == nil {
		@missingImage(b, m.Image)
	} else {
		<figure class="block block-image" id={ "block-" + b.ID }>
			@web.PictureMobile(img, mobile, m.Alt, sizesFull)
			if m.Caption != "" {
				<figcaption>{ m.Caption }</figcaption>
			}
		</figure>
	}
}

templ imageTextView(b Block, m *ImageText, img, mobile *images.Image) {
	<div class={ "block", "block-image-text", templ.KV("block-image-right", m.right()) } id={ "block-" + b.ID }>
		if img == nil {
			@missingImage(b, m.Image)
		} else {
			<figure class="block-image-text-media">
				@web.PictureMobile(img, mobile, m.Alt, sizesHalf)
				if m.Caption != "" {
					<figcaption>{ m.Caption }</figcaption>
				}
			</figure>
		}
		<div class="block-image-text-body">
			@markdown(m.Body)
		</div>
	</div>
}

// galleryView — галерея: лента слайдов с прокруткой и привязкой (CSS scroll-snap, без JavaScript).
// Лента получает фокус с клавиатуры, чтобы её можно было прокрутить стрелками.
templ galleryView(b Block, g *Gallery, res Resolved) {
	<div class="block block-gallery" id={ "block-" + b.ID }>
		<ul class="gallery-track" tabindex="0" aria-label="Галерея">
			for _, it := range g.Items {
				if img := res[it.Image]; img != nil {
					<li class="gallery-slide">
						<figure>
							@web.PictureMobile(img, res[it.ImageMobile], it.Alt, sizesSlide)
							if it.Caption != "" {
								<figcaption>{ it.Caption }</figcaption>
							}
						</figure>
					</li>
				} else {
					@missingImage(b, it.Image)
				}
			}
		</ul>
	</div>
}

// listingView — блок-список: записи типа контента (вывод — код типа). Источника нет — блок не выводится, в лог —
// предупреждение; записей нет — источник отдаёт пустой вывод.
templ listingView(b Block, records templ.Component) {
	if records == nil {
		@missingList(b)
	} else {
		<div class={ "block", "block-list", "block-" + strings.ReplaceAll(b.Type, "_", "-") } id={ "block-" + b.ID }>
			@records
		</div>
	}
}

templ quoteView(b Block, q *Quote) {
	<figure class="block block-quote" id={ "block-" + b.ID }>
		<blockquote>
			for _, p := range paragraphs(q.Text) {
				<p>{ p }</p>
			}
		</blockquote>
		if q.Author != "" {
			<figcaption>{ q.Author }</figcaption>
		}
	</figure>
}

// fileView — блок file: видео — плеер (preload="metadata": файл качается частями по мере просмотра), SVG —
// картинка, остальное (PDF) — ссылка с форматом и размером. Файла нет — блок не выводится.
templ fileView(b Block, m *File, f *files.File) {
	if f == nil {
		@missingFile(b, m.File)
	} else if f.Format.IsVideo() {
		<figure class="block block-file block-video" id={ "block-" + b.ID }>
			<video controls preload="metadata" src={ web.FileURL(f) }>
				<a href={ templ.SafeURL(web.FileURL(f)) }>{ fileTitle(m, f) }</a>
			</video>
			if m.Title != "" {
				<figcaption>{ m.Title }</figcaption>
			}
		</figure>
	} else if f.Format == files.SVG {
		<figure class="block block-file block-svg" id={ "block-" + b.ID }>
			<img src={ web.FileURL(f) } alt={ m.Title } loading="lazy"/>
		</figure>
	} else {
		<p class="block block-file block-download" id={ "block-" + b.ID }>
			<a href={ templ.SafeURL(web.FileURL(f)) }>{ fileTitle(m, f) }</a>
			<span class="file-meta">{ web.FileFormat(f.Format) }, { web.FormatBytes(f.Bytes) }</span>
		</p>
	}
}

// fileTitle — текст ссылки на файл: подпись блока, без неё — имя файла.
func fileTitle(m *File, f *files.File) string {
	if m.Title != "" {
		return m.Title
	}
	if f.Name != "" {
		return f.Name
	}
	return f.URLName
}

// unknownView — блок неизвестного типа на сайт не выводится, только пишется в лог.
func unknownView(b Block) templ.Component {
	return templ.ComponentFunc(func(ctx context.Context, _ io.Writer) error {
		logUnknown(ctx, b)
		return nil
	})
}

// missingList — у блока-списка нет источника записей (ListSources в cmd/site): на сайт он не выводится.
func missingList(b Block) templ.Component {
	return templ.ComponentFunc(func(ctx context.Context, _ io.Writer) error {
		slog.WarnContext(ctx, "blocks: no list source", "type", b.Type, "id", b.ID)
		return nil
	})
}

// missingImage — изображения нет (внешний ключ этого не допускает, но данные могли прийти из копии БД):
// блок без картинки, в лог — предупреждение.
func missingImage(b Block, id string) templ.Component {
	return templ.ComponentFunc(func(ctx context.Context, _ io.Writer) error {
		slog.WarnContext(ctx, "blocks: image not found", "block", b.ID, "image", id)
		return nil
	})
}

// missingFile — файла нет (как missingImage): блок не выводится, в лог — предупреждение.
func missingFile(b Block, id string) templ.Component {
	return templ.ComponentFunc(func(ctx context.Context, _ io.Writer) error {
		slog.WarnContext(ctx, "blocks: file not found", "block", b.ID, "file", id)
		return nil
	})
}

// markdown — Markdown блока как очищенный HTML (richtext.Render).
func markdown(src string) templ.Component {
	return templ.ComponentFunc(func(ctx context.Context, w io.Writer) error {
		html, err := richtext.Render(src)
		if err != nil {
			return err
		}
		return html.Render(ctx, w)
	})
}

// paragraphs — абзацы цитаты: разделены пустой строкой; переводы строк внутри абзаца сохраняет CSS (pre-line).
func paragraphs(s string) []string {
	var out []string
	for _, p := range strings.Split(s, "\n\n") {
		if p = strings.TrimSpace(p); p != "" {
			out = append(out, p)
		}
	}
	return out
}

package blocks

import (
	"strconv"

	"github.com/voffkin/keelkit/modules/files"
	"github.com/voffkin/keelkit/modules/images"

	"github.com/voffkin/keelkit/reference/internal/web"
)

// Editor — блоки в форме админки: по порядку, затем меню «Добавить блок» (<details>: без JavaScript открывается
// так же; после выбора static/editor.js его закрывает).
// Кнопки блоков — submit с name="action" (Apply): без JavaScript они отправляют форму целиком, сервер выполняет
// действие и возвращает форму, ничего не сохраняя; с htmx та же отправка подменяет форму. «Добавить блок» через htmx
// запрашивает только фрагмент нового блока (BlockURL?type=) и дописывает его в конец списка.
templ Editor(list []Block, e FormEnv) {
	<fieldset class="blocks-editor" aria-describedby="blocks-hint">
		<legend>Блоки</legend>
		<span class="field-hint" id="blocks-hint">Страница собирается из блоков сверху вниз. Скрытый блок остаётся здесь, но не выводится на сайте.</span>
		if msg := e.Errors["blocks"]; msg != "" {
			<span class="field-error" id="blocks-error">{ msg }</span>
		}
		<div id="blocks" class="blocks">
			for _, b := range list {
				@Form(b, e)
			}
		</div>
		if len(list) == 0 {
			<p class="muted blocks-empty">Блоков пока нет: добавьте первый.</p>
		}
		<details class="block-add">
			<summary>Добавить блок</summary>
			<div class="block-add-menu">
				for _, name := range e.Allow {
					<button
						type="submit"
						name="action"
						value={ "add:" + name }
						class="secondary"
						formnovalidate
						hx-post={ e.BlockURL + "?type=" + name }
						hx-params="none"
						hx-target="#blocks"
						hx-swap="beforeend"
					>{ Title(name) }</button>
				}
			</div>
		</details>
	</fieldset>
}

// Form — фрагмент формы одного блока (и ответ на POST BlockURL).
templ Form(b Block, e FormEnv) {
	<section class={ "block-form", templ.KV("block-hidden", b.Hidden) } id={ "block-" + b.ID } aria-labelledby={ "block-" + b.ID + "-title" }>
		<input type="hidden" name="block" value={ b.ID }/>
		<input type="hidden" name={ FieldName(b.ID, "type") } value={ b.Type }/>
		if b.Hidden {
			<input type="hidden" name={ FieldName(b.ID, "hidden") } value="1"/>
		}
		<div class="block-head">
			<h3 id={ "block-" + b.ID + "-title" }>{ Title(b.Type) }</h3>
			if b.Hidden {
				<span class="status status-draft">Скрыт</span>
			}
			<div class="block-controls">
				<button type="submit" name="action" value={ "up:" + b.ID } class="link-button" formnovalidate title="Выше" aria-label="Переместить блок выше">↑</button>
				<button type="submit" name="action" value={ "down:" + b.ID } class="link-button" formnovalidate title="Ниже" aria-label="Переместить блок ниже">↓</button>
				<button type="submit" name="action" value={ "hide:" + b.ID } class="link-button" formnovalidate>
					if b.Hidden {
						Показать
					} else {
						Скрыть
					}
				</button>
				<button type="submit" name="action" value={ "remove:" + b.ID } class="link-button danger-link" formnovalidate>Удалить блок</button>
			</div>
		</div>
		@b.Content.form(b, e)
	</section>
}

templ textForm(b Block, t *Text, e FormEnv) {
	@markdownField(b, "body", "Текст (Markdown)", t.Body, e)
}

templ imageForm(b Block, m *Image, e FormEnv) {
	@imageField(b, "image", m.Image, e) {
		@textField(b, "alt", "Описание (alt)", m.Alt, "Что изображено — для тех, кто не видит картинку, и для поисковиков.", e)
		@textField(b, "caption", "Подпись", m.Caption, "Необязательно: выводится под изображением.", e)
	}
}

templ imageTextForm(b Block, m *ImageText, e FormEnv) {
	@imageField(b, "image", m.Image, e) {
		@textField(b, "alt", "Описание (alt)", m.Alt, "Что изображено — для тех, кто не видит картинку, и для поисковиков.", e)
		@textField(b, "caption", "Подпись", m.Caption, "Необязательно: выводится под изображением.", e)
	}
	<fieldset class="block-position">
		<legend>Изображение</legend>
		<label class="checkbox">
			<input type="radio" name={ FieldName(b.ID, "position") } value={ PositionLeft } checked?={ !m.right() }/>
			слева
		</label>
		<label class="checkbox">
			<input type="radio" name={ FieldName(b.ID, "position") } value={ PositionRight } checked?={ m.right() }/>
			справа
		</label>
	</fieldset>
	@markdownField(b, "body", "Текст (Markdown)", m.Body, e)
}

// galleryForm — элементы галереи по порядку: у каждого изображение, alt, подпись и кнопки ↑ ↓ «Убрать»
// (действия item-… в Apply, как у блоков). «Добавить изображение» добавляет пустой элемент в конец.
templ galleryForm(b Block, g *Gallery, e FormEnv) {
	@fieldError(b, "items", e)
	<ol class="block-items">
		for i, it := range g.Items {
			<li class="block-item" id={ itemAnchor(b, it.ID) } aria-labelledby={ itemAnchor(b, it.ID) + "-title" }>
				<input type="hidden" name={ FieldName(b.ID, "item") } value={ it.ID }/>
				<div class="block-head">
					<h4 id={ itemAnchor(b, it.ID) + "-title" }>Изображение { strconv.Itoa(i + 1) }</h4>
					<div class="block-controls">
						<button type="submit" name="action" value={ itemAction("up", b, it.ID) } class="link-button" formnovalidate title="Выше" aria-label="Переместить изображение выше">↑</button>
						<button type="submit" name="action" value={ itemAction("down", b, it.ID) } class="link-button" formnovalidate title="Ниже" aria-label="Переместить изображение ниже">↓</button>
						<button type="submit" name="action" value={ itemAction("remove", b, it.ID) } class="link-button danger-link" formnovalidate>Убрать</button>
					</div>
				</div>
				@imageField(b, ItemField(it.ID, "image"), it.Image, e) {
					@textField(b, ItemField(it.ID, "alt"), "Описание (alt)", it.Alt, "Что изображено — для тех, кто не видит картинку, и для поисковиков.", e)
					@textField(b, ItemField(it.ID, "caption"), "Подпись", it.Caption, "Необязательно: выводится под изображением.", e)
				}
			</li>
		}
	</ol>
	if len(g.Items) < MaxItems {
		<div>
			<button type="submit" name="action" value={ "item-add:" + b.ID } class="secondary" formnovalidate>Добавить изображение</button>
		</div>
	}
}

// fileForm — блок file: выбор файла из раздела «Файлы» и подпись.
templ fileForm(b Block, m *File, e FormEnv) {
	{{ name := FieldName(b.ID, "file") }}
	<label>
		Файл
		<select
			name={ name }
			if e.err(b, "file") != "" {
				aria-invalid="true"
				aria-describedby={ name + "-hint " + name + "-error" }
			} else {
				aria-describedby={ name + "-hint" }
			}
		>
			<option value="">— выберите —</option>
			for _, f := range fileOptions(m.File, e) {
				<option value={ f.ID } selected?={ f.ID == m.File }>{ fileOptionLabel(f) }</option>
			}
		</select>
		<span class="field-hint" id={ name + "-hint" }>
			PDF — ссылкой, видео — плеером, SVG — картинкой. Новый файл сначала загрузите в раздел <a href={ templ.SafeURL(e.FilesURL) } target="_blank">«Файлы»</a>.
		</span>
		@fieldError(b, "file", e)
	</label>
	@textField(b, "title", "Подпись", m.Title, "Текст ссылки на PDF (пусто — имя файла), подпись под видео, описание SVG (alt, обязательно).", e)
}

templ quoteForm(b Block, q *Quote, e FormEnv) {
	<label>
		Цитата
		<textarea
			name={ FieldName(b.ID, "text") }
			rows="4"
			class="short"
			if e.err(b, "text") != "" {
				aria-invalid="true"
				aria-describedby={ FieldName(b.ID, "text") + "-error" }
			}
		>{ q.Text }</textarea>
		@fieldError(b, "text", e)
	</label>
	@textField(b, "author", "Автор", q.Author, "Необязательно.", e)
}

// listingForm — у блока-списка полей нет: подсказка, откуда берутся записи, и ссылка на их раздел.
templ listingForm(b Block, adminURL string) {
	<p class="field-hint">
		Здесь на сайте — все записи раздела «{ Title(b.Type) }» в порядке из раздела.
		if adminURL != "" {
			<a href={ templ.SafeURL(adminURL) } target="_blank">Открыть раздел</a>
		}
	</p>
}

templ unknownForm(b Block, u *Unknown) {
	<input type="hidden" name={ FieldName(b.ID, "raw") } value={ u.Raw }/>
	<p class="field-hint">
		Этого типа блока нет в коде сайта: на сайте он не выводится, данные сохраняются как есть.
		Его можно переставить, скрыть или удалить.
	</p>
}

// textField — однострочное поле блока с подсказкой и ошибкой.
templ textField(b Block, field, label, value, hint string, e FormEnv) {
	{{ name := FieldName(b.ID, field) }}
	<label>
		{ label }
		<input
			type="text"
			name={ name }
			value={ value }
			maxlength={ strconv.Itoa(maxShort) }
			if e.err(b, field) != "" {
				aria-invalid="true"
				aria-describedby={ name + "-hint " + name + "-error" }
			} else {
				aria-describedby={ name + "-hint" }
			}
		/>
		<span class="field-hint" id={ name + "-hint" }>{ hint }</span>
		@fieldError(b, field, e)
	</label>
}

// markdownField — textarea Markdown с панелью оформления и превью рядом. Превью обновляется при наборе с задержкой
// (htmx, только это поле — hx-params); hx-sync отменяет устаревший запрос. При открытии формы превью рисует сервер.
// Панель — кнопки, которые оборачивают выделение разметкой Markdown (static/editor.js); без JavaScript её не видно.
// Метка — через for, а не обёрткой: кнопки внутри label перехватили бы её связь с textarea.
templ markdownField(b Block, field, label, value string, e FormEnv) {
	{{ name := FieldName(b.ID, field) }}
	<div class="editor">
		<div class="md-field">
			<label for={ name }>{ label }</label>
			@markdownToolbar(name)
			<textarea
				id={ name }
				name={ name }
				rows="10"
				hx-post={ e.PreviewURL + "?field=" + name }
				hx-params={ name }
				hx-trigger="input changed delay:400ms"
				hx-target={ "#" + name + "-preview" }
				hx-swap="innerHTML"
				hx-sync="this:replace"
				if e.err(b, field) != "" {
					aria-invalid="true"
					aria-describedby={ name + "-error" }
				}
			>{ value }</textarea>
			@fieldError(b, field, e)
		</div>
		<section class="preview" aria-label="Превью">
			<p class="preview-title" aria-hidden="true">Превью</p>
			<div id={ name + "-preview" } class="page" aria-live="polite">
				@Preview(value)
			</div>
		</section>
	</div>
}

// markdownToolbar — панель оформления для textarea с id target. data-md — действие в static/editor.js.
// Надписи — классические английские (B, I, S, H2…), подсказка (title) — по-русски; aria-label начинается
// с видимой надписи, чтобы голосовое управление находило кнопку по ней.
// Подчёркивания нет: в Markdown его нет, а сырой HTML (<u>) не пропускается.
templ markdownToolbar(target string) {
	<div class="md-toolbar" role="toolbar" aria-label="Оформление текста" aria-controls={ target }>
		<button type="button" data-md="bold" title="Жирный (Ctrl+B)" aria-label="B — жирный"><b>B</b></button>
		<button type="button" data-md="italic" title="Курсив (Ctrl+I)" aria-label="I — курсив"><i>I</i></button>
		<button type="button" data-md="strike" title="Зачёркнутый" aria-label="S — зачёркнутый"><s>S</s></button>
		<button type="button" data-md="link" title="Ссылка (Ctrl+K)" aria-label="Link — ссылка">Link</button>
		<button type="button" data-md="heading" title="Подзаголовок" aria-label="H2 — подзаголовок">H2</button>
		<button type="button" data-md="ul" title="Маркированный список" aria-label="UL — маркированный список">UL</button>
		<button type="button" data-md="ol" title="Нумерованный список" aria-label="OL — нумерованный список">OL</button>
		<button type="button" data-md="quote" title="Цитата" aria-label="Quote — цитата">Quote</button>
		<button type="button" data-md="code" title="Код" aria-label="Code — код"><code>&lt;/&gt;</code></button>
	</div>
}

// Preview — превью Markdown (и ответ на POST PreviewURL).
templ Preview(src string) {
	if src == "" {
		<p class="preview-empty">Здесь появится превью текста.</p>
	} else {
		@markdown(src)
	}
}

// imageField — выбор изображения из медиатеки в поле field блока (у элемента списка — ItemField): превью слева,
// справа выбор и children — поля этого изображения (alt, подпись). Смена выбора через htmx перерисовывает блок
// (BlockURL?id=): появляется превью выбранной картинки. Без JavaScript превью обновится после отправки формы.
templ imageField(b Block, field, id string, e FormEnv) {
	{{ name := FieldName(b.ID, field) }}
	<div class="block-image-pick">
		<div class="block-thumb">
			if img := e.Resolved[id]; img != nil {
				@web.Picture(img, "", "8rem")
			} else {
				<span class="muted">Не выбрано</span>
			}
		</div>
		<div class="block-image-fields">
			<label>
				Изображение
				<select
					name={ name }
					hx-post={ e.BlockURL + "?id=" + b.ID }
					hx-trigger="change"
					hx-target={ "#block-" + b.ID }
					hx-swap="outerHTML"
					if e.err(b, field) != "" {
						aria-invalid="true"
						aria-describedby={ name + "-hint " + name + "-error" }
					} else {
						aria-describedby={ name + "-hint" }
					}
				>
					<option value="">— выберите —</option>
					for _, img := range options(id, e) {
						<option value={ img.ID } selected?={ img.ID == id }>{ optionLabel(img) }</option>
					}
				</select>
				<span class="field-hint" id={ name + "-hint" }>
					Новое изображение сначала загрузите в <a href={ templ.SafeURL(e.MediaURL) } target="_blank">медиатеку</a>.
				</span>
				@fieldError(b, field, e)
			</label>
			{ children... }
		</div>
	</div>
}

templ fieldError(b Block, field string, e FormEnv) {
	if msg := e.err(b, field); msg != "" {
		<span class="field-error" id={ FieldName(b.ID, field) + "-error" }>{ msg }</span>
	}
}

// itemAnchor — id элемента списка в форме: block-<блок>-i-<элемент>.
func itemAnchor(b Block, item string) string { return "block-" + b.ID + "-i-" + item }

// itemAction — значение кнопки действия над элементом: item-<op>:<блок>:<элемент>.
func itemAction(op string, b Block, item string) string { return "item-" + op + ":" + b.ID + ":" + item }

// options — изображения для выбора: Library и выбранное, если его там нет (загружено давно).
func options(id string, e FormEnv) []*images.Image {
	if img := e.Resolved[id]; img != nil {
		for _, l := range e.Library {
			if l.ID == id {
				return e.Library
			}
		}
		return append([]*images.Image{img}, e.Library...)
	}
	return e.Library
}

func optionLabel(img *images.Image) string {
	name := img.Name
	if name == "" {
		name = img.ID
	}
	return name + " · " + strconv.Itoa(img.Width) + "×" + strconv.Itoa(img.Height)
}

// fileOptions — файлы для выбора: FileLib и выбранный, если его там нет (загружен давно).
func fileOptions(id string, e FormEnv) []*files.File {
	if f := e.Files[id]; f != nil {
		for _, l := range e.FileLib {
			if l.ID == id {
				return e.FileLib
			}
		}
		return append([]*files.File{f}, e.FileLib...)
	}
	return e.FileLib
}

func fileOptionLabel(f *files.File) string {
	name := f.Name
	if name == "" {
		name = f.URLName
	}
	return name + " · " + web.FileFormat(f.Format) + ", " + web.FormatBytes(f.Bytes)
}

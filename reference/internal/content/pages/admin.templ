package pages

import (
	"github.com/voffkin/keelkit/reference/internal/admin"
	"github.com/voffkin/keelkit/reference/internal/richtext"
)

// ListPage — список страниц в админке.
templ ListPage(list []ListPagesRow, deleted bool) {
	@admin.Layout("Страницы") {
		<div class="admin-title">
			<h1>Страницы</h1>
			<a class="button" href={ templ.SafeURL(AdminPath + "/new") }>Создать страницу</a>
		</div>
		if deleted {
			<p class="flash" role="status">Страница удалена.</p>
		}
		if len(list) == 0 {
			<p>Страниц пока нет.</p>
		} else {
			<div class="table-wrap">
				<table class="admin-table">
					<thead>
						<tr>
							<th>Заголовок</th>
							<th>Адрес</th>
							<th>Статус</th>
							<th>Обновлена</th>
						</tr>
					</thead>
					<tbody>
						for _, p := range list {
							<tr>
								<td><a href={ templ.SafeURL(editPath(p.ID)) }>{ p.Title }</a></td>
								<td>
									if p.Draft {
										<span class="muted">{ publicPath(p.Slug) }</span>
									} else {
										<a href={ templ.SafeURL(publicPath(p.Slug)) }>{ publicPath(p.Slug) }</a>
									}
								</td>
								<td>
									if p.Draft {
										<span class="status status-draft">Черновик</span>
									} else {
										<span class="status">Опубликована</span>
									}
								</td>
								<td>{ formatTime(p.UpdatedAt) }</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	}
}

// FormPage — страница создания или редактирования.
templ FormPage(f pageForm) {
	@admin.Layout(formTitle(f)) {
		<p class="breadcrumbs"><a href={ templ.SafeURL(AdminPath) }>Страницы</a></p>
		<div class="admin-title">
			<h1>{ formTitle(f) }</h1>
			if f.ID != 0 && !f.Published {
				<a href={ templ.SafeURL(viewPath(f.ID)) }>Предпросмотр</a>
			} else if f.ID != 0 && f.Errors == nil {
				<a href={ templ.SafeURL(publicPath(f.Slug)) }>Открыть на сайте</a>
			}
		</div>
		if f.Saved {
			<p class="flash" role="status">Сохранено.</p>
		}
		@Form(f)
	}
}

// Form — форма страницы. Отправляется через htmx: с ошибками сервер возвращает только этот фрагмент (422),
// и он заменяет форму целиком; без JavaScript та же форма работает обычным POST.
// Превью Markdown обновляется при наборе с задержкой; hx-sync отменяет устаревший запрос.
templ Form(f pageForm) {
	<form
		id="page-form"
		class="form page-form"
		method="post"
		action={ templ.SafeURL(formAction(f)) }
		hx-post={ formAction(f) }
		hx-target="this"
		hx-swap="outerHTML"
	>
		@admin.CSRFInput()
		if len(f.Errors) > 0 {
			<p class="form-error" role="alert">Исправьте ошибки в форме.</p>
		}
		<label>
			Заголовок
			<input
				type="text"
				name="title"
				value={ f.Title }
				required
				maxlength="200"
				if f.Errors["title"] != "" {
					aria-invalid="true"
					aria-describedby="title-error"
				}
			/>
			@fieldError(f, "title")
		</label>
		<label>
			Slug
			<input
				type="text"
				name="slug"
				value={ f.Slug }
				placeholder="составится из заголовка"
				if f.Errors["slug"] != "" {
					aria-invalid="true"
					aria-describedby="slug-hint slug-error"
				} else {
					aria-describedby="slug-hint"
				}
			/>
			<span class="field-hint" id="slug-hint">Адрес страницы: латиница, цифры и дефисы. Пусто — составится из заголовка.</span>
			@fieldError(f, "slug")
		</label>
		<div class="editor">
			<label>
				Текст (Markdown)
				<textarea
					name="body"
					rows="18"
					hx-post={ AdminPath + "/preview" }
					hx-trigger="input changed delay:400ms"
					hx-target="#page-preview"
					hx-swap="innerHTML"
					hx-sync="this:replace"
					if f.Errors["body"] != "" {
						aria-invalid="true"
						aria-describedby="body-error"
					}
				>{ f.Body }</textarea>
				@fieldError(f, "body")
			</label>
			<section class="preview" aria-labelledby="preview-title">
				<h2 id="preview-title" class="preview-title">Превью</h2>
				<div id="page-preview" class="page" aria-live="polite">
					@Preview(f.Preview)
				</div>
			</section>
		</div>
		<label class="checkbox">
			<input
				type="checkbox"
				name="draft"
				value="1"
				checked?={ f.Draft }
				if f.Errors["draft"] != "" {
					aria-invalid="true"
					aria-describedby="draft-hint draft-error"
				} else {
					aria-describedby="draft-hint"
				}
			/>
			Черновик
		</label>
		<span class="field-hint" id="draft-hint">Черновик не виден на сайте и в меню. Снимите флажок и сохраните, чтобы опубликовать.</span>
		@fieldError(f, "draft")
		<div class="form-actions">
			<button type="submit">Сохранить</button>
			<a href={ templ.SafeURL(AdminPath) }>Отмена</a>
		</div>
		if f.ID != 0 {
			<p class="danger-zone">
				if !f.Published {
					<a class="danger-link" href={ templ.SafeURL(editPath(f.ID) + "/delete") }>Удалить черновик</a>
				} else {
					<span class="field-hint">{ deleteHint(f.Slug) }</span>
				}
			</p>
		}
	</form>
}

// Preview — содержимое блока превью (ответ на POST /admin/pages/preview).
templ Preview(body richtext.HTML) {
	if body == "" {
		<p class="preview-empty">Здесь появится превью текста.</p>
	} else {
		@body
	}
}

templ fieldError(f pageForm, field string) {
	if msg := f.Errors[field]; msg != "" {
		<span class="field-error" id={ field + "-error" }>{ msg }</span>
	}
}

// DeletePage — подтверждение удаления.
templ DeletePage(p Page) {
	@admin.Layout("Удаление страницы") {
		<p class="breadcrumbs"><a href={ templ.SafeURL(AdminPath) }>Страницы</a></p>
		<h1>Удалить черновик «{ p.Title }»?</h1>
		<p>Черновик на сайте не виден, но его текст пропадёт и из админки. Отменить удаление нельзя.</p>
		<form method="post" action={ templ.SafeURL(editPath(p.ID) + "/delete") } class="form-actions">
			@admin.CSRFInput()
			<button type="submit" class="danger">Удалить</button>
			<a href={ templ.SafeURL(editPath(p.ID)) }>Отмена</a>
		</form>
	}
}

// DeleteBlockedPage — попытка удалить опубликованную страницу (409): что сделать сначала.
templ DeleteBlockedPage(p Page) {
	@admin.Layout("Удаление страницы") {
		<p class="breadcrumbs"><a href={ templ.SafeURL(AdminPath) }>Страницы</a></p>
		<h1>Страница «{ p.Title }» опубликована</h1>
		<p>{ deleteHint(p.Slug) }</p>
		<p><a href={ templ.SafeURL(editPath(p.ID)) }>Вернуться к редактированию</a></p>
	}
}

// deleteHint — почему опубликованную страницу нельзя удалить сразу.
func deleteHint(slug string) string {
	if slug == HomeSlug {
		return "Главная страница всегда опубликована, поэтому удалить её нельзя."
	}
	return "Удалить можно только черновик: отметьте «Черновик», сохраните — страница пропадёт с сайта, — и тогда удалите."
}

func formTitle(f pageForm) string {
	if f.ID == 0 {
		return "Новая страница"
	}
	return "Редактирование страницы"
}

func formAction(f pageForm) string {
	if f.ID == 0 {
		return AdminPath
	}
	return editPath(f.ID)
}

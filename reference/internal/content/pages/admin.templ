package pages

import (
	"github.com/voffkin/keelkit/reference/internal/admin"
	"github.com/voffkin/keelkit/reference/internal/blocks"
	"github.com/voffkin/keelkit/reference/internal/seofields"
)

// ListPage — список страниц в админке.
templ ListPage(list []ListPagesRow, deleted bool) {
	@admin.Layout("Страницы") {
		<div class="admin-title">
			<h1>Страницы</h1>
			<a class="button" href={ templ.SafeURL(AdminPath + "/new") }>Создать страницу</a>
		</div>
		if deleted {
			<p class="flash" role="status">Страница удалена.</p>
		}
		if len(list) == 0 {
			<p>Страниц пока нет.</p>
		} else {
			<div class="table-wrap">
				<table class="admin-table">
					<thead>
						<tr>
							<th>Заголовок</th>
							<th>Адрес</th>
							<th>Статус</th>
							<th>Обновлена</th>
						</tr>
					</thead>
					<tbody>
						for _, p := range list {
							<tr>
								<td><a href={ templ.SafeURL(EditPath(p.ID)) }>{ p.Title }</a></td>
								<td>
									if p.PublishedSlug == "" {
										<span class="muted">{ PublicPath(p.Slug) }</span>
									} else {
										<a href={ templ.SafeURL(PublicPath(p.PublishedSlug)) }>{ PublicPath(p.PublishedSlug) }</a>
									}
								</td>
								<td>
									@status(p.PublishedSlug != "", p.Changed != 0)
								</td>
								<td>{ formatTime(p.UpdatedAt) }</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	}
}

// status — статус страницы: черновик, опубликована, есть неопубликованные изменения.
templ status(published, changed bool) {
	switch {
		case !published:
			<span class="status status-draft">Черновик</span>
		case changed:
			<span class="status status-changed">Есть неопубликованные изменения</span>
		default:
			<span class="status">Опубликована</span>
	}
}

// FormPage — страница создания или редактирования: форма и рядом живой предпросмотр (admin.Live, Admin.Live).
templ FormPage(f pageForm) {
	@admin.Layout(formTitle(f)) {
		@admin.Live(AdminPath+"/live", "page-form") {
			<p class="breadcrumbs"><a href={ templ.SafeURL(AdminPath) }>Страницы</a></p>
			<div class="admin-title">
				<h1>{ formTitle(f) }</h1>
				if f.ID != 0 {
					@status(f.Published, f.Changed)
					<a href={ templ.SafeURL(viewPath(f.ID)) }>Предпросмотр черновика</a>
					if f.Published {
						<a href={ templ.SafeURL(PublicPath(f.PublishedSlug)) }>Открыть на сайте</a>
					}
				}
			</div>
			if f.Flash != "" {
				<p class="flash" role="status">{ f.Flash }</p>
			}
			@Form(f)
			if f.ID != 0 {
				<div class="danger-zone">
					if f.Published && f.PublishedSlug != HomeSlug {
						<form method="post" action={ templ.SafeURL(EditPath(f.ID) + "/unpublish") } class="form-actions">
							@admin.CSRFInput()
							<button type="submit" class="secondary">Снять с публикации</button>
							<span class="field-hint">Страница пропадёт с сайта и из меню; черновик останется здесь.</span>
						</form>
					}
					if !f.Published {
						<p><a class="danger-link" href={ templ.SafeURL(EditPath(f.ID) + "/delete") }>Удалить страницу</a></p>
					} else {
						<p class="field-hint">{ deleteHint(f.PublishedSlug) }</p>
					}
				</div>
			}
		}
	}
}

// Form — форма страницы. Отправляется через htmx: с ошибками сервер возвращает только этот фрагмент (422),
// и он заменяет форму целиком; без JavaScript та же форма работает обычным POST. Кнопка — поле action:
// «Сохранить» (save) пишет черновик, «Опубликовать» (publish) — ещё и показывает его на сайте, кнопки блоков —
// действия blocks.Apply (форма возвращается изменённой, без сохранения).
templ Form(f pageForm) {
	<form
		id="page-form"
		class="form page-form"
		method="post"
		action={ templ.SafeURL(formAction(f)) }
		hx-post={ formAction(f) }
		hx-target="this"
		hx-swap="outerHTML"
	>
		@admin.CSRFInput()
		// Enter в поле нажимает первую кнопку формы: пусть это будет «Сохранить», а не «↑» первого блока.
		<button type="submit" name="action" value="save" class="visually-hidden" tabindex="-1" aria-hidden="true">Сохранить</button>
		if len(f.Errors) > 0 {
			<p class="form-error" role="alert">Исправьте ошибки в форме.</p>
		}
		if f.Unsaved {
			<p class="flash flash-warning" role="status">Изменения ещё не сохранены: нажмите «Сохранить» или «Опубликовать».</p>
		}
		<label>
			Заголовок
			<input
				type="text"
				name="title"
				value={ f.Title }
				required
				maxlength="200"
				if f.Errors["title"] != "" {
					aria-invalid="true"
					aria-describedby="title-error"
				}
			/>
			@fieldError(f, "title")
		</label>
		<label>
			Slug
			<input
				type="text"
				name="slug"
				value={ f.Slug }
				placeholder="составится из заголовка"
				if f.Errors["slug"] != "" {
					aria-invalid="true"
					aria-describedby="slug-hint slug-error"
				} else {
					aria-describedby="slug-hint"
				}
			/>
			<span class="field-hint" id="slug-hint">Адрес страницы: латиница, цифры и дефисы. Пусто — составится из заголовка. Новый адрес появится на сайте после публикации.</span>
			@fieldError(f, "slug")
		</label>
		@blocks.Editor(f.Blocks, f.Env)
		@seofields.Section(f.SEO, f.SEOEnv)
		<div class="form-actions">
			<button type="submit" name="action" value="save">Сохранить</button>
			<button type="submit" name="action" value="publish" class="secondary">Опубликовать</button>
			<a href={ templ.SafeURL(AdminPath) }>Отмена</a>
		</div>
		<span class="field-hint">«Сохранить» — сохранить черновик, на сайте ничего не изменится. «Опубликовать» — сохранить и показать на сайте.</span>
	</form>
}

templ fieldError(f pageForm, field string) {
	if msg := f.Errors[field]; msg != "" {
		<span class="field-error" id={ field + "-error" }>{ msg }</span>
	}
}

// DeletePage — подтверждение удаления.
templ DeletePage(f pageForm) {
	@admin.Layout("Удаление страницы") {
		<p class="breadcrumbs"><a href={ templ.SafeURL(AdminPath) }>Страницы</a></p>
		<h1>Удалить страницу «{ f.Title }»?</h1>
		<p>Страница не опубликована, но её черновик пропадёт и из админки. Отменить удаление нельзя.</p>
		<form method="post" action={ templ.SafeURL(EditPath(f.ID) + "/delete") } class="form-actions">
			@admin.CSRFInput()
			<button type="submit" class="danger">Удалить</button>
			<a href={ templ.SafeURL(EditPath(f.ID)) }>Отмена</a>
		</form>
	}
}

// BlockedPage — действие недоступно в текущем состоянии страницы (409): что сделать сначала.
templ BlockedPage(f pageForm, reason string) {
	@admin.Layout("Действие недоступно") {
		<p class="breadcrumbs"><a href={ templ.SafeURL(AdminPath) }>Страницы</a></p>
		<h1>Страница «{ f.Title }» опубликована</h1>
		<p>{ reason }</p>
		<p><a href={ templ.SafeURL(EditPath(f.ID)) }>Вернуться к редактированию</a></p>
	}
}

// UsedPage — на страницу ведут пункты меню (409): удалить её можно, только убрав их.
templ UsedPage(f pageForm, used []Usage) {
	@admin.Layout("Удаление страницы") {
		<p class="breadcrumbs"><a href={ templ.SafeURL(AdminPath) }>Страницы</a></p>
		<h1>Страница «{ f.Title }» стоит в меню</h1>
		<p>Страницу нельзя удалить, пока на неё ведёт пункт меню. Сначала уберите его:</p>
		<ul class="usage-list">
			for _, u := range used {
				<li><a href={ templ.SafeURL(u.URL) }>{ u.Title }</a></li>
			}
		</ul>
		<p><a href={ templ.SafeURL(EditPath(f.ID)) }>Вернуться к редактированию</a></p>
	}
}

// deleteHint — почему опубликованную страницу нельзя удалить сразу.
func deleteHint(publishedSlug string) string {
	if publishedSlug == HomeSlug {
		return "Главная страница всегда опубликована, поэтому удалить её нельзя."
	}
	return "Удалить можно только неопубликованную страницу: сначала снимите её с публикации."
}

func formTitle(f pageForm) string {
	if f.ID == 0 {
		return "Новая страница"
	}
	return "Редактирование страницы"
}

func formAction(f pageForm) string {
	if f.ID == 0 {
		return AdminPath
	}
	return EditPath(f.ID)
}

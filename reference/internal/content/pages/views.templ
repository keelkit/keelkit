package pages

import (
	"github.com/voffkin/keelkit/reference/internal/blocks"
	"github.com/voffkin/keelkit/reference/internal/web"
)

// viewData — страница для публичного шаблона: опубликованная копия или (Preview) черновик в админке.
type viewData struct {
	ID       int64
	Title    string
	Slug     string
	Blocks   []blocks.Block
	Resolved blocks.Resolved
	Preview  bool // предпросмотр черновика: плашка со ссылкой в редактор
}

// View — публичная страница. На главной в <title> только название сайта; описание — начало текста блоков.
// Предпросмотр черновика видит только админка — с плашкой и ссылкой в редактор.
templ View(p viewData) {
	@web.LayoutMeta(viewTitle(p), blocks.Summary(p.Blocks, descriptionLen)) {
		if p.Preview {
			<p class="draft-banner" role="status">
				Предпросмотр черновика: так страница будет выглядеть после публикации.
				<a href={ templ.SafeURL(EditPath(p.ID)) }>Вернуться к редактированию</a>
			</p>
		}
		<article class="page">
			<h1>{ p.Title }</h1>
			@blocks.View(p.Blocks, p.Resolved)
		</article>
	}
}

// HomeEmpty — главная, пока страница со slug home не опубликована.
templ HomeEmpty() {
	{{ site := web.SiteFrom(ctx) }}
	@web.Layout("") {
		<h1>{ site.Name }</h1>
		if site.Description != "" {
			<p class="lead">{ site.Description }</p>
		}
		<p>Главная страница ещё не опубликована: создайте и опубликуйте страницу со slug «{ HomeSlug }».</p>
	}
}

func viewTitle(p viewData) string {
	if p.Slug == HomeSlug {
		return ""
	}
	return p.Title
}

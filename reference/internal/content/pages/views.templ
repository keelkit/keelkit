package pages

import (
	"github.com/keelkit/keelkit/modules/images"

	"github.com/keelkit/keelkit/reference/internal/blocks"
	"github.com/keelkit/keelkit/reference/internal/seofields"
	"github.com/keelkit/keelkit/reference/internal/web"
)

// viewData — страница для публичного шаблона: опубликованная копия или (Preview) черновик в админке.
type viewData struct {
	ID       int64
	Title    string
	Slug     string
	Blocks   []blocks.Block
	Resolved blocks.Resolved
	Files    blocks.Files // файлы блоков file
	Lists    blocks.Lists // записи блоков-списков (people)
	SEO      seofields.Fields
	SEOImage *images.Image // картинка SEO.Image; nil — подстановка
	Preview  bool          // предпросмотр черновика: плашка со ссылкой в редактор
	Live     bool          // живой предпросмотр в редакторе (Admin.Live): без плашки, редактор рядом
}

// View — публичная страница. Данные для поисковиков — viewMeta: заданные вручную (SEO) или подстановка. Предпросмотр черновика видит только админка — с плашкой
// и ссылкой в редактор, без canonical и с noindex.
templ View(p viewData) {
	@web.LayoutMeta(viewMeta(p)) {
		if p.Preview && !p.Live {
			<p class="draft-banner" role="status">
				Предпросмотр черновика: так страница будет выглядеть после публикации.
				<a href={ templ.SafeURL(EditPath(p.ID)) }>Вернуться к редактированию</a>
			</p>
		}
		<article class="page">
			<h1>{ p.Title }</h1>
			@blocks.View(p.Blocks, p.Resolved, p.Files, p.Lists)
		</article>
	}
}

// HomeEmpty — главная, пока страница со slug home не опубликована.
templ HomeEmpty() {
	{{ site := web.SiteFrom(ctx) }}
	@web.LayoutMeta(web.Meta{Path: "/"}) {
		<h1>{ site.Name }</h1>
		if site.Description != "" {
			<p class="lead">{ site.Description }</p>
		}
		<p>Главная страница ещё не опубликована: создайте и опубликуйте страницу со slug «{ HomeSlug }».</p>
	}
}

// viewMeta — данные для поисковиков: SEO, заданное вручную, поверх подстановки — заголовок страницы (на главной
// в <title> только название сайта), начало текста блоков, первое изображение блоков.
func viewMeta(p viewData) web.Meta {
	m := web.Meta{
		Title:       p.Title,
		Description: blocks.Summary(p.Blocks, descriptionLen),
		Path:        PublicPath(p.Slug),
		Image:       blocks.FirstImage(p.Blocks, p.Resolved),
	}
	if p.Slug == HomeSlug {
		m.Title = ""
	}
	m = p.SEO.Apply(m, p.SEOImage)
	if p.Preview {
		m.Path, m.NoIndex = "", true
	}
	return m
}

# /etc/site/site.env — настройки сайта для site.service и site-backup.service (права 0640, владелец root:site).
# Сайт слушает только localhost: TLS и порты 80/443 — у reverse proxy (Caddy, nginx), см. AGENTS.md.
ADDR=127.0.0.1:8080
BASE_URL=https://example.com
DATA_DIR=/var/lib/site/data
BACKUP_DIR=/var/lib/site/backups
TZ=Europe/Moscow
